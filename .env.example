# speakr API（需 read+write scope 的 Token）
SPEAKR_URL=http://speakr:8899
SPEAKR_TOKEN=<your-api-token>

# Webhook secret（POST /api/v1/webhooks 创建时一次性返回，务必保存）
WEBHOOK_SECRET=<webhook-secret>
# 轮换宽限期的旧 secret（可选）
#WEBHOOK_SECRET_PREVIOUS=

# 浏览器可达的服务基址（B7 通道①；为空则 widget 走 notes 回退通道）
#API_URL_PUBLIC=http://82.156.1.74:8898

# LLM 精判（OpenAI 兼容 /chat/completions；不启用则纯词表，source=lexicon）
#LLM_ENABLED=1
#LLM_BASE_URL=http://<intranet-qwen>/v1
#LLM_API_KEY=<key>
#LLM_MODEL=qwen2.5-72b-instruct

# /alerts 看板 Basic Auth（留空则仅限本机访问）
#ALERT_USER=admin
#ALERT_PASS=<password>
